{
  "name": "AccountRequest",
  "type": "object",
  "properties": {
    "businessName": {
      "type": "string",
      "title": "Business Name"
    },
    "businessId": {
      "type": "string",
      "title": "Business ID (\u05d7.\u05e4)"
    },
    "contactName": {
      "type": "string",
      "title": "Contact Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "handled": {
      "type": "boolean",
      "default": false,
      "title": "Handled"
    }
  },
  "required": [
    "contactName",
    "phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "imtidharcrimow@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "tidharben@tidharben.com"
          }
        }
      ]
    },
    "create": false,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "imtidharcrimow@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "tidharben@tidharben.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "imtidharcrimow@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "tidharben@tidharben.com"
          }
        }
      ]
    }
  }
}