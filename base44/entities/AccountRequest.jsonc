{
  "name": "AccountRequest",
  "type": "object",
  "properties": {
    "businessName": {
      "type": "string",
      "title": "Business Name"
    },
    "businessId": {
      "type": "string",
      "title": "Business ID (\u05d7.\u05e4)"
    },
    "contactName": {
      "type": "string",
      "title": "Contact Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "handled": {
      "type": "boolean",
      "default": false,
      "title": "Handled"
    }
  },
  "required": [
    "businessId",
    "contactName",
    "phone"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": false,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}