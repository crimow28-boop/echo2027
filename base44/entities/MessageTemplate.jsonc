{
  "name": "MessageTemplate",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "recording",
        "missed"
      ],
      "default": "recording",
      "title": "Message Kind"
    },
    "body": {
      "type": "string",
      "title": "Message Body Template"
    }
  },
  "required": [
    "body"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}