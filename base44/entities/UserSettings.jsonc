{
  "name": "UserSettings",
  "type": "object",
  "properties": {
    "clientName": {
      "type": "string",
      "title": "Client Name"
    },
    "clientEmail": {
      "type": "string",
      "title": "Client Login Email"
    },
    "ownerUserId": {
      "type": "string",
      "title": "Owner User Id"
    },
    "exmToken": {
      "type": "string",
      "title": "EXM API Token"
    },
    "greenInstanceId": {
      "type": "string",
      "title": "Green API Instance ID"
    },
    "greenToken": {
      "type": "string",
      "title": "Green API Token"
    }
  },
  "required": [
    "exmToken"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.ownerUserId": "{{user.id}}"
        },
        {
          "data.clientEmail": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}