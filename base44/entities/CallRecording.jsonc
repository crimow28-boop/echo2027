{
  "name": "CallRecording",
  "type": "object",
  "properties": {
    "externalId": {
      "type": "string",
      "title": "External Call ID"
    },
    "callDate": {
      "type": "string",
      "format": "date-time",
      "title": "Call Date"
    },
    "callerNumber": {
      "type": "string",
      "title": "Caller Number"
    },
    "callerFriendly": {
      "type": "string",
      "title": "Caller Friendly Name"
    },
    "callType": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing"
      ],
      "default": "incoming",
      "title": "Call Type"
    },
    "duration": {
      "type": "number",
      "title": "Duration (seconds)"
    },
    "recordingUrl": {
      "type": "string",
      "title": "Recording URL"
    },
    "recordingMissing": {
      "type": "boolean",
      "default": false,
      "title": "No Recording Saved"
    },
    "listenToken": {
      "type": "string",
      "title": "Public Listen Link Token"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "title": "Hidden (Private Contact)"
    },
    "sent": {
      "type": "boolean",
      "default": false,
      "title": "Sent to Client"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "title": "Sent At"
    },
    "transcript": {
      "type": "array",
      "title": "Transcript Segments",
      "items": {
        "type": "object",
        "properties": {
          "speaker": {
            "type": "string",
            "enum": [
              "agent",
              "client"
            ],
            "default": "client",
            "title": "Speaker"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        }
      }
    },
    "transcribedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Transcribed At"
    },
    "summary": {
      "type": "string",
      "title": "Call Summary"
    },
    "summarySentAt": {
      "type": "string",
      "format": "date-time",
      "title": "Summary Sent At"
    }
  },
  "required": [
    "callerNumber",
    "callType",
    "duration"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.hidden": {
            "$ne": true
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}