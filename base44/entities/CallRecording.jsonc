{
  "name": "CallRecording",
  "type": "object",
  "properties": {
    "externalId": {
      "type": "string",
      "title": "External Call ID"
    },
    "callDate": {
      "type": "string",
      "format": "date-time",
      "title": "Call Date"
    },
    "callerNumber": {
      "type": "string",
      "title": "Caller Number"
    },
    "callerFriendly": {
      "type": "string",
      "title": "Caller Friendly Name"
    },
    "callType": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing"
      ],
      "default": "incoming",
      "title": "Call Type"
    },
    "duration": {
      "type": "number",
      "title": "Duration (seconds)"
    },
    "recordingUrl": {
      "type": "string",
      "title": "Recording URL"
    },
    "sent": {
      "type": "boolean",
      "default": false,
      "title": "Sent to Client"
    }
  },
  "required": [
    "callerNumber",
    "callType",
    "duration"
  ],
  "rls": {
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}